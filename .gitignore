# Virtual environments
venv/
venv-*/
.venv/
env/

# Python bytecode / build
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# HuggingFace / model caches (if redirected into the project via HF_HOME etc.)
.cache/
hf_cache/
huggingface/
transformers_modules/
models/
checkpoints/
*.safetensors
*.bin
*.onnx
*.pt
*.pth

# MTEB outputs
results/
mteb_results/
predictions/

# Benchmark / evaluation logs (the ONNX CPU benchmarks are kept: the README cites them)
*.log
!bench_onnx*.log
!bench_torch*.log

# Generated data artifacts
*.npy
*.npz
embeddings/

# Notebooks
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Only the prebuilt apps index is committed (PLAN.md step 3); folder indexes built with `cli.py index`
# (default indexes/<folder name>) stay local. Its embeddings are an exception to *.npy above.
indexes/*
!indexes/apps/
!indexes/apps/*.npy
# Zips uploaded through the web page are unpacked here (web/server.py --uploads).
uploads/
